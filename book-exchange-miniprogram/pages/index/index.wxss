.hero {
  background: linear-gradient(135deg, #FF9A4D, #FF7A30);
  padding: 30rpx 32rpx 40rpx;
  color: #fff;
}
.hero-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.hero-loc { font-size: 26rpx; opacity: 0.95; }
.hero-coin {
  background: rgba(255, 255, 255, 0.22);
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
}
.hero-title { font-size: 40rpx; font-weight: 700; margin-top: 28rpx; }
.hero-sub { font-size: 26rpx; opacity: 0.92; margin-top: 10rpx; }

.cats {
  white-space: nowrap;
  padding: 24rpx 20rpx 8rpx;
}
.cat {
  display: inline-block;
  padding: 12rpx 30rpx;
  margin-right: 16rpx;
  background: #fff;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #6b6258;
}
.cat-active {
  background: #FF8A3D;
  color: #fff;
  font-weight: 600;
}

.list { padding: 12rpx 24rpx; }

.book {
  display: flex;
  padding: 22rpx;
  margin-bottom: 22rpx;
}
.book-cover {
  width: 140rpx;
  height: 190rpx;
  border-radius: 14rpx;
  font-size: 70rpx;
  flex-shrink: 0;
}
.book-main {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}
.book-title { font-size: 32rpx; font-weight: 600; line-height: 1.3; }
.book-author { font-size: 24rpx; margin-top: 6rpx; }
.book-tags { margin-top: 14rpx; }
.book-bottom {
  margin-top: auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.coin { font-size: 30rpx; }
.owner { font-size: 24rpx; }

.empty {
  padding: 70rpx 40rpx;
  text-align: center;
  color: #6b6258;
}
.empty-emoji { font-size: 80rpx; margin-bottom: 16rpx; }
.empty-btn { margin-top: 30rpx; width: 240rpx; }
