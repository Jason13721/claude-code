<view class="page">

  <view class="tip card">
    📷 正式版可「扫 ISBN 条码」自动识别书名、封面与分类，这里先手动填写。
  </view>

  <view class="form card">

    <view class="field">
      <view class="label">选个封面</view>
      <view class="covers">
        <view
          wx:for="{{covers}}"
          wx:key="emoji"
          class="cover-pick {{coverIndex === index ? 'cover-pick-on' : ''}}"
          style="background:{{item.color}}"
          data-i="{{index}}"
          bindtap="onPickCover">{{item.emoji}}</view>
      </view>
    </view>

    <view class="field">
      <view class="label">书名 <text class="req">*</text></view>
      <input class="input" placeholder="如：猜猜我有多爱你" data-field="title"
        value="{{title}}" bindinput="onInput" />
    </view>

    <view class="field">
      <view class="label">作者</view>
      <input class="input" placeholder="选填" data-field="author"
        value="{{author}}" bindinput="onInput" />
    </view>

    <view class="field">
      <view class="label">分类</view>
      <picker mode="selector" range="{{categories}}" data-field="categoryIndex" bindchange="onPick">
        <view class="picker">{{categories[categoryIndex]}} ›</view>
      </picker>
    </view>

    <view class="field">
      <view class="label">适读年龄</view>
      <picker mode="selector" range="{{ages}}" data-field="ageIndex" bindchange="onPick">
        <view class="picker">{{ages[ageIndex]}} ›</view>
      </picker>
    </view>

    <view class="field">
      <view class="label">品相</view>
      <picker mode="selector" range="{{conditions}}" data-field="conditionIndex" bindchange="onPick">
        <view class="picker">{{conditions[conditionIndex]}} ›</view>
      </picker>
    </view>

    <view class="field">
      <view class="label">一句话介绍</view>
      <textarea class="textarea" placeholder="如：孩子很喜欢，几乎全新～" data-field="desc"
        value="{{desc}}" bindinput="onInput" />
    </view>

  </view>

  <view class="estimate card">
    <view>预计可得</view>
    <view class="coin estimate-num">{{estimate}} 书币</view>
  </view>

  <button class="btn-primary submit" bindtap="onSubmit">上架并领取书币</button>

</view>
