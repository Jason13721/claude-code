.page { padding: 24rpx; }

.tip {
  padding: 22rpx 26rpx;
  font-size: 24rpx;
  color: #9a7b5c;
  background: #FFF7EF;
  line-height: 1.5;
}

.form { margin-top: 24rpx; padding: 8rpx 30rpx; }

.field {
  padding: 26rpx 0;
  border-bottom: 2rpx solid #f1ece4;
}
.field:last-child { border-bottom: none; }
.label { font-size: 28rpx; color: #6b6258; margin-bottom: 16rpx; }
.req { color: #EF7E72; }

.input, .picker, .textarea {
  font-size: 30rpx;
  width: 100%;
  box-sizing: border-box;
}
.picker { color: #2b2b2b; }
.textarea { height: 120rpx; }

.covers { display: flex; flex-wrap: wrap; }
.cover-pick {
  width: 84rpx; height: 84rpx;
  border-radius: 14rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx; color: #fff;
  margin: 0 18rpx 18rpx 0;
  opacity: 0.55;
  border: 4rpx solid transparent;
}
.cover-pick-on { opacity: 1; border-color: #FF7A30; }

.estimate {
  margin-top: 24rpx;
  padding: 28rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
}
.estimate-num { font-size: 40rpx; }

.submit { margin-top: 36rpx; height: 92rpx; line-height: 92rpx; }
