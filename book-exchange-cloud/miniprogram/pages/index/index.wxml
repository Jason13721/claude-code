<view class="page">

  <view class="hero">
    <view class="hero-row">
      <view class="hero-loc">📍 {{community}}</view>
      <view class="hero-coin" bindtap="goPublish">书币 {{credits}} 🪙</view>
    </view>
    <view class="hero-title">让闲置童书在小区里流动起来</view>
    <view class="hero-sub">贡献一本得书币 · 用书币换走想读的书</view>
  </view>

  <scroll-view scroll-x="true" class="cats" show-scrollbar="false">
    <view
      wx:for="{{categories}}"
      wx:key="*this"
      class="cat {{active === item ? 'cat-active' : ''}}"
      data-cat="{{item}}"
      bindtap="onTapCategory">{{item}}</view>
  </scroll-view>

  <view class="list">
    <view wx:if="{{loading}}" class="loading muted center">加载中…</view>

    <view wx:elif="{{books.length === 0}}" class="empty card">
      <view class="empty-emoji">📭</view>
      <view>这个分类还没有书</view>
      <view class="muted">不如把你家的闲置书发布上来？</view>
      <button class="btn-primary empty-btn" bindtap="goPublish">去发布</button>
    </view>

    <view
      wx:for="{{books}}"
      wx:key="_id"
      class="book card"
      data-id="{{item._id}}"
      bindtap="onTapBook">
      <view class="cover book-cover" style="background:{{item.color}}">{{item.cover}}</view>
      <view class="book-main">
        <view class="book-title">{{item.title}}</view>
        <view class="muted book-author">{{item.author}}</view>
        <view class="book-tags">
          <text class="tag">{{item.ageRange}}</text>
          <text class="tag">{{item.condition}}</text>
        </view>
        <view class="book-bottom">
          <text class="coin">{{item.credits}} 书币</text>
          <text class="muted owner">{{item.ownerAddress}}</text>
        </view>
      </view>
    </view>
  </view>

</view>
